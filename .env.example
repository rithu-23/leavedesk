# Copy this file to .env and replace every value. Never commit .env.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
DEMO_PASSWORD=replace-me
ACCESS_TOKEN_MINUTES=30
LOG_LEVEL=INFO

# ---- PostgreSQL (Capstone 3) ----
# Superuser of the postgres container; used only by docker/postgres-init/01-roles.sh.
POSTGRES_PASSWORD=replace-me-too
# Passwords for the two roles the init script creates (SCHEMA.md section 6).
# Use letters and digits only, so they need no escaping inside the URLs below.
MIGRATOR_PASSWORD=replace-with-migrator-password
APP_PASSWORD=replace-with-app-password

# URLs for running on your Mac: Docker publishes the database on localhost:5433 (see
# docker-compose.yml). Inside containers, docker-compose.yml overrides the host to "db:5432". Repeat the passwords from above: .env files cannot reference variables.
# With DATABASE_URL set, the API stores everything in PostgreSQL (run `alembic upgrade head`
# first). Comment it out to go back to in-memory storage. DB_ECHO=true logs every SQL statement.
MIGRATION_DATABASE_URL=postgresql+psycopg://leavedesk_migrator:replace-with-migrator-password@localhost:5433/leavedesk
DATABASE_URL=postgresql+psycopg://leavedesk_app:replace-with-app-password@localhost:5433/leavedesk

# The test suite's database tests (tests/db) use the separate leavedesk_test database.
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://leavedesk_migrator:replace-with-migrator-password@localhost:5433/leavedesk_test
TEST_DATABASE_URL=postgresql+psycopg://leavedesk_app:replace-with-app-password@localhost:5433/leavedesk_test
